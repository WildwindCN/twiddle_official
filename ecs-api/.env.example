# twiddle-official-waitlist 后端配置 (systemd EnvironmentFile 用)
# 部署时 cp .env.example /opt/twiddle_official/ecs-api/.env && chmod 600

PORT=8791
HOST=127.0.0.1
DATA_DIR=/opt/twiddle_official/data
PUBLIC_BASE=https://twiddle-ai.com.cn

# Resend 邮件确认 (Resend 免费档 100/天, 3k/月)
# 没有也能跑,只是用户提交后不自动发欢迎邮件,记录仍然入库
RESEND_API_KEY=
MAIL_FROM=Twiddle AI <contact@twiddle-ai.com>
