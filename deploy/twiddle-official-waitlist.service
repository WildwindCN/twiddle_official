# systemd 单元: /etc/systemd/system/twiddle-official-waitlist.service
# 部署:
#   sudo cp deploy/twiddle-official-waitlist.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now twiddle-official-waitlist.service
#   journalctl -u twiddle-official-waitlist.service -f

[Unit]
Description=TwiddleSEED waitlist API (Node http, stdlib-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/twiddle_official
EnvironmentFile=/opt/twiddle_official/ecs-api/.env
ExecStart=/usr/bin/node ecs-api/server.mjs
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

# 资源限制 — 小服务,留够余量即可
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
